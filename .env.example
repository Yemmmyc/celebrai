# ==============================================================================
# CelebrAI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your Google Gemini API key:
#   cp .env.example .env
#
# Obtain a free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/
# ==============================================================================

# Google Gemini API Key (Required for AI bespoke creative styling)
# If left blank or not configured, CelebrAI uses its built-in deterministic planning engine.
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Gemini Model Identifier (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# API Request Timeout in Milliseconds (Optional, defaults to 30000)
GEMINI_TIMEOUT_MS=30000

# SQLite Database Path (Optional, defaults to celebrai.db in project root)
# CELEBRAI_DB_PATH=celebrai.db
